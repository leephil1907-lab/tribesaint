# Tribe Culture — environment variables
# Copy to .env for local work, or set these in the Render dashboard.
# Never commit real values.

PORT=3000

# Where the store keeps its JSON database. On Render this is the mounted disk.
TC_DATA_DIR=./data

# Public URL of the store. Leave blank locally so links follow the request host.
SITE_URL=https://tribeculture.store/

# Studio (admin) password — required. /studio stays locked until this is set.
# Use a long random value; treat it like any other credential.
ADMIN_PASSWORD=

# Paystack — start with test keys, switch to live only after a real test order.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Resend (order + invoice emails)
RESEND_API_KEY=

# Order notifications
STORE_EMAIL=orders@tribeculture.store
FROM_EMAIL=Tribe Culture <orders@tribeculture.store>

# Let the store complete orders without live Paystack keys (preview mode).
# Set to false once live keys are in place.
ALLOW_PREVIEW_CHECKOUT=true
